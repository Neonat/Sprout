<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed background -->
    <ImageView
        android:id="@+id/bg_garden"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_garden"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header row -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_garden_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Garden"
            android:textColor="@color/black"
            android:fontFamily="cursive"
            android:textStyle="bold"
            android:textSize="48sp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Shelf section 1 (top shelf) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shelf_section_1"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <!-- Shelf plank 1 -->
        <ImageView
            android:id="@+id/shelf_plank_1"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_shelf"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 3 pots aligned to the plank surface -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="@id/shelf_plank_1"
            android:layout_marginBottom="30dp">

            <ImageView
                android:id="@+id/pot_0"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pot_empty"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/pot_1"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pot_empty"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/pot_2"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pot_empty"
                android:padding="4dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Shelf section 2 (bottom shelf) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shelf_section_2"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.75">

        <!-- Shelf plank 2 -->
        <ImageView
            android:id="@+id/shelf_plank_2"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_shelf"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 3 pots aligned to the plank surface -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="@id/shelf_plank_2"
            android:layout_marginBottom="30dp">

            <ImageView
                android:id="@+id/pot_3"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pot_empty"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/pot_4"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pot_empty"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/pot_5"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pot_empty"
                android:padding="4dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Back button -->
    <Button
        android:id="@+id/btn_back"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="36dp"
        android:text="← Back"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
