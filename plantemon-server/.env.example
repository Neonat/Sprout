# Third-party APIs (held server-side ONLY — never expose to client)
PLANT_API_KEY=your_plant_id_key
NVIDIA_API_KEY=your_nvidia_key
FLUX_API_KEY=your_nvidia_key

# Clerk auth (get from clerk.com dashboard)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Neon Postgres (auto-set by Vercel ↔ Neon integration)
DATABASE_URL=postgres://...

# Vercel Blob (auto-set by Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
