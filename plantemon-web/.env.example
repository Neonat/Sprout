# Copy to .env.local and fill in. Never commit .env.local.
# These are the same keys the Android app read from Plantemon/local.properties.

# Plant.id — https://plant.id (free tier available)
PLANT_API_KEY=

# NVIDIA — https://build.nvidia.com
# Both keys are NVIDIA credentials; they are named for the model they
# authenticate. The same key works for both if you only have one.
# NVIDIA_API_KEY is accepted as a fallback for either.
GEMMA_API_KEY=
FLUX_API_KEY=

# Google AI Studio — https://ai.studio/projects
# Primary vision model for the sprite prompt (~1.5s, vs 69s-or-timeout for the
# NVIDIA fallback). Optional: when unset, or when its prepaid credits run out,
# the sprite route falls back to NVIDIA. A missing key costs latency, not scans.
GEMINI_KEY=

# Optional. Overrides the Gemini vision model. Defaults to gemini-3.5-flash-lite.
# Avoid the thinking models here: reasoning tokens draw from the same output
# budget and truncate the prompt mid-sentence.
GEMINI_VISION_MODEL=

# Optional. Overrides the NVIDIA fallback vision model, so a retired model can be
# swapped without a code change. Defaults to google/gemma-4-31b-it.
NVIDIA_VISION_MODEL=

# withoutBG — https://withoutbg.com (Pro model, 1 credit per successful call)
# Strips the generated sprite's background to a true RGBA cutout. Optional:
# when unset, sprite generation returns the raw render instead of failing.
WITHOUTBG_KEY=

# Clerk — https://dashboard.clerk.com
# The publishable key is meant to reach the browser; the secret key must NEVER
# be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Routing: keep Clerk on our own pages and give OAuth a post-callback target.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Postgres connection string. Neon works well with the serverless driver:
# https://neon.tech — create a project, copy the pooled connection string.
# Then run: npm run db:migrate
DATABASE_URL=
